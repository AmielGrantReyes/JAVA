import java.util.Arrays;

public class SearchAndSortMiniTool {
    public static void main(String[] args) {
        int[] scores = {85, 92, 78, 95, 88, 76};
        int target = 95;
        int foundIndex = -1;

        for (int i = 0; i < scores.length; i++) {
            if (scores[i] == target) {
                foundIndex = i;
                break;
            }
        }

        if (foundIndex != -1) {
            System.out.println("Found at index: " + foundIndex);
        } else {
            System.out.println("Not found");
        }

        // Sort a copy to preserve the original array and its indexes.
        int[] sortedScores = Arrays.copyOf(scores, scores.length);
        Arrays.sort(sortedScores);

        System.out.println("Original: " + Arrays.toString(scores));
        System.out.println("Sorted: " + Arrays.toString(sortedScores));
    }
}
