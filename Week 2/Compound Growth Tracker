public class CompoundGrowthTrackef{
    public static void main(String[] args) {
        int balance = 100;

        System.out.println("Initial Balance: " + balance);

        balance += 20;
        System.out.println("After Step 1 (+20): " + balance);

        balance *= 2;
        System.out.println("After Step 2 (*2): " + balance);

        balance += 50;
        System.out.println("After Step 3 (+50): " + balance);

        balance *= 3;
        System.out.println("After Step 4 (*3): " + balance);

       
        int count = 5;

        System.out.println("\nInitial Count: " + count);

        // Postfix (count++) prints current value first, then increment count.
        System.out.println("Postfix count++: " + count++);
        System.out.println("Count after postfix: " + count);

        // Prefix (++count) increments count first, then prints the new value.
        System.out.println("Prefix ++count: " + ++count);
        System.out.println("Count after prefix: " + count);

    }
}
